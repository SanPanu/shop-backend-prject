{
  // Use the project's own Python (3.9) and run tests with pytest.
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "python.testing.pytestArgs": ["tests"],

  // Hide files that are generated automatically, so the Explorer shows only real project files.
  "files.exclude": {
    "**/__pycache__": true,
    "**/.pytest_cache": true,
    "**/.DS_Store": true,
    "**/*.pyc": true
  },
  "search.exclude": {
    ".venv": true,
    "playwright-report": true,
    "websphere/build": true
  }
}
